{% extends 'layouts/site.twig' %}
{% block title %}{{ title }} — Inna documentation{% endblock %}
{% block body_class %}docs{% endblock %}
{% block content %}
<a class="skip" href="#article">Skip to documentation</a>
<header class="docs-header">
    <a class="brand" href="/">inna<span class="brand-dot">.</span></a>
    <span class="docs-label">Documentation</span>
    <label class="search"><i data-lucide="search"></i><input id="search" type="search" placeholder="Search documentation..." aria-label="Search documentation"><kbd>/</kbd></label>
    <a class="github-link" href="https://github.com/ekwachie/inna">GitHub <i data-lucide="arrow-up-right"></i></a>
    <span class="version">v2.0.0</span>
    {% include 'partials/theme-toggle.twig' %}
    <button class="menu-toggle" aria-label="Toggle documentation navigation" aria-controls="docs-navigation" aria-expanded="false"><i data-lucide="menu"></i></button>
</header>
<div class="docs-grid">
    <aside class="sidebar" id="docs-navigation">
        <a class="back-home" href="/"><i data-lucide="arrow-left"></i> Inna home</a>
        <nav aria-label="Documentation">
            {% for group in groups %}
            <details open>
                <summary>{{ group.title }}</summary>
                {% for page in group.pages %}
                <a href="/documentation/{{ page.path }}" data-topic="{{ page.path }}"{% if currentDoc == page.path %} class="active" aria-current="page"{% endif %}>{{ page.title }}</a>
                {% endfor %}
            </details>
            {% endfor %}
            <p class="no-results" hidden role="status">No guides found. Try another search.</p>
        </nav>
        <a class="sidebar-footer" href="https://payperlez.org/">Built by Payperlez <i data-lucide="arrow-up-right"></i></a>
    </aside>
    <main class="doc-main" id="article">
        <div class="doc-topline"><span>{{ breadcrumb }}</span><span>Guides <i data-lucide="arrow-right"></i></span></div>
        <article id="doc-content">{{ content|raw }}</article>
        <nav class="doc-pagination" aria-label="Adjacent guides">
            {% if previous %}<a href="/documentation/{{ previous.path }}">Previous: {{ previous.title }}</a>{% else %}<span></span>{% endif %}
            {% if next %}<a href="/documentation/{{ next.path }}">Next: {{ next.title }}</a>{% endif %}
        </nav>
        <div class="doc-help">Something missing? <a href="https://github.com/ekwachie/inna/issues">Open an issue <i data-lucide="arrow-up-right"></i></a></div>
    </main>
    <aside class="toc">
        {% if toc %}<span>On this page</span><nav aria-label="On this page">{% for heading in toc %}<a href="#{{ heading.id }}">{{ heading.title }}</a>{% endfor %}</nav>{% endif %}
        <div class="toc-note"><i data-lucide="terminal"></i><strong>Make it yours.</strong><p>Start small. Build at your own pace.</p><a href="/documentation/getting-started/installation">Install Inna <i data-lucide="arrow-right"></i></a></div>
    </aside>
</div>
<script id="doc-search" type="application/json">{{ searchJson|raw }}</script>
{% endblock %}

