SECRET_KEY = 
AUDIT_LOG_SECRET = 
DB_DSN = mysql:host=127.0.0.1;port=3306;dbname=inna;charset=utf8mb4
DB_USER = DB_USER
DB_PASSWORD = DB_PASSWORD
DOMAIN = 127.0.0.1:8080

# Environment: development or production
# If not set, will auto-detect from HTTPS
APP_ENV = development
APP_NAME = "Inna Framework"
APP_LOG_DIR=
TRUSTED_PROXY_IPS=

JWT_SECRET=
JWT_ISSUER=inna_api
JWT_TTL=3600

# Optional private uploads: absolute directory outside this checkout, permissions 0700.
STORAGE_PATH=
STORAGE_KEY_ID=v1
# Generate a separate 32-byte hex key with: openssl rand -hex 32
STORAGE_KEY=

# Optional server-to-server services. The API key selects test/live.
PAYPERLEZ_BASE_URL=https://api.payperlez.org/api/v1
PAYPERLEZ_API_KEY=
PAYPERLEZ_BUSINESS_ID=
PAYPERLEZ_WEBHOOK_SECRET=
PAYPERLEZ_ENVIRONMENT=test

# Optional email (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME="Inna"
